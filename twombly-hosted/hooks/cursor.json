{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/feedback.mjs\" cursor-prepare",
        "timeout": 5
      }
    ],
    "afterMCPExecution": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/feedback.mjs\" cursor-remember",
        "timeout": 5
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/feedback.mjs\" cursor-context",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/feedback.mjs\" cursor-stop",
        "timeout": 3600,
        "loop_limit": null
      }
    ]
  }
}
