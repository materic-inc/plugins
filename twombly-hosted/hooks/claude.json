{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__.*twombly__open_canvas",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/feedback.mjs",
              "remember"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/feedback.mjs",
              "check"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/feedback.mjs",
              "wait"
            ],
            "timeout": 3600,
            "asyncRewake": true
          }
        ]
      }
    ]
  }
}
