{
  "description": "Comments the person sends to their agent from the Twombly canvas reach it.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/hook.mjs\" check codex",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/hook.mjs\" continue codex",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
