{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "twombly",
  "version": "0.5.1",
  "description": "Get feedback, huddle, and iterate with your team on a canvas beside your agent.",
  "author": {
    "name": "Materic, Inc.",
    "url": "https://twombly.app"
  },
  "license": "MIT",
  "homepage": "https://twombly.app",
  "keywords": [
    "design",
    "canvas",
    "prototype"
  ],
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "hooks": "./hooks/codex.json",
      "interface": {
        "displayName": "Twombly",
        "shortDescription": "Design versions side by side",
        "longDescription": "Get feedback, huddle, and iterate with your team on a canvas beside your agent.",
        "developerName": "Materic",
        "category": "Design",
        "capabilities": [
          "Interactive",
          "Read",
          "Write"
        ],
        "websiteURL": "https://twombly.app",
        "privacyPolicyURL": "https://twombly.app/privacy",
        "termsOfServiceURL": "https://twombly.app/terms",
        "supportURL": "https://twombly.app",
        "defaultPrompt": [
          "Put our signup flow on Twombly so I can review every step side by side.",
          "Make three versions of the pricing page and lay them out on a canvas.",
          "Keep what I tuned on the selected frame."
        ],
        "brandColor": "#0066FF",
        "composerIcon": "./assets/mark.png",
        "logo": "./assets/logo.png",
        "logoDark": "./assets/logo.png"
      }
    }
  }
}
